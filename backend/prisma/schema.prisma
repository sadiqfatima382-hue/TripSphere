generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
  SUPPORT
}

model User {
  id        String   @id @default(uuid())

  firstName String
  lastName  String

  email     String   @unique
  password  String

  phone     String?

  role      UserRole @default(CUSTOMER)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}
