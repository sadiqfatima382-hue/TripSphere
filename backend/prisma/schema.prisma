generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
  SUPPORT
}


model User {
  id        String   @id @default(uuid())

  firstName String
  lastName  String

  email     String   @unique
  password  String

  phone     String?

  role      UserRole @default(CUSTOMER)

  isActive  Boolean  @default(true)

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())

  token     String   @unique

  userId    String

  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

